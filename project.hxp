  var envConfig:Null<Map<String, String>> = null;
  var astcExcludes:Array<String> = [];

  public function new()
  {
    super();

    #if !target.unicode
    if (isWindowsHost()) Sys.command("chcp 65001 > nul");
    #end

    envConfig = readEnvironmentFile(ENV_FILE);

    flair();
    displayTarget();
    configureFeatureFlags();
    configureApp();
    configureOutputDir();

    if (isPassiveCommand()) return;

    configureCompileDefines();
    configureIncludeMacros();
    configureCustomMacros();
    configurePolymod();
    configureHaxelibs();
    configureASTCTextures();
    configureAssets();

    if (!isLinux()) configureIcons();
    if (FEATURE_MOBILE_ADVERTISEMENTS.isEnabled(this)) configureAdMobKeys();
    if (isAndroid()) configureAndroid();
    if (isIOS()) configureIOS();
    if (isCPP()) buildHxCppTools();
    if (!isToolingCommand()) checkLibraries();
    if (FEATURE_CPPIA.isEnabled(this)) configureCppiaSdk();
  }

  function flair():Void
  {
    info("Friday Night Funkin' - " + VERSION);
    info("Initializing build...");
    info("Git Branch:     " + getGitBranch());
    info("Git Commit:     " + getGitCommit());
    info("Git Modified?   " + getGitModified());
    info("Display?        " + isDisplay());
  }

  function displayTarget():Void
  {
    var platformName:Null<String> = switch (this.target)
    {
      case Platform.WINDOWS: 'Windows';
      case Platform.MAC: 'MacOS';
      case Platform.LINUX: 'Linux';
      case Platform.ANDROID: 'Android';
      case Platform.IOS: 'iOS';
      case Platform.HTML5: 'HTML5';
      default: null;
    }

    if (platformName == null) error('Unsupported platform (got ${this.target})');
    info('Target Platform: $platformName');

    var typeName:Null<String> = switch (this.platformType)
    {
      case PlatformType.DESKTOP: 'Desktop';
      case PlatformType.MOBILE: 'Mobile';
      case PlatformType.WEB: 'Web';
      case PlatformType.CONSOLE: 'Console';
      default: null;
    }

    if (typeName == null) error('Unknown platform type (got ${this.platformType})');
    info('Target Platform Type: $typeName');

    if (isWeb()) info('Target Language: JavaScript (HTML5)');
    else if (isCPP()) info('Target Language: C++');
    else error('Unsupported target language!');

    for (arch in this.architectures)
    {
      switch (arch)
      {
        case Architecture.X86:
          info('Target Architecture: x86');
        case Architecture.X64:
          info('Target Architecture: x64');
        case Architecture.ARMV7:
          info('Target Architecture: ARMv7');
        case Architecture.ARM64:
          info('Target Architecture: ARM64');
        case null:
          if (isWeb()) info('Target Architecture: Web');
          else error('Unsupported architecture (got null on non-web platform)');
        default:
          error('Unsupported architecture (got ${arch})');
      }
    }

    if (isIOS()) info('iOS Simulator Build: ' + isIOSSimulator());
  }

  function configureFeatureFlags():Void
  {
    GITHUB_BUILD.apply(this, false);
    EXCLUDE_ARMV7.apply(this, false);
    VERBOSE_ASSET_CACHE.apply(this, false);

    FEATURE_DEBUG_FUNCTIONS.apply(this, isDebug() || GITHUB_BUILD.isEnabled(this));
    FEATURE_RESULTS_DEBUG.apply(this, isDebug() || GITHUB_BUILD.isEnabled(this));

    HARDCODED_CREDITS.apply(this, true);
    UNLOCK_EVERYTHING.apply(this, true);

    EMBED_ASSETS.apply(this, isWeb());
    PRELOAD_ALL.apply(this, !isWeb());
    REDIRECT_ASSETS_FOLDER.apply(this, isDebug() && isDesktop());
    CENSOR_EXPLETIVES.apply(this, isMobile());
    FORCE_BLEND_SHADER.apply(this, isAndroid());

    FEATURE_FUNKVIS.apply(this, true);
    FEATURE_LOG_TRACE.apply(this, true);
    FEATURE_DEBUG_FILE_LOGGING.apply(this, FEATURE_DEBUG_FUNCTIONS.isEnabled(this));
    FEATURE_NATIVE_CRASH_HANDLER.apply(this, isDesktop() && isCPP());
    FEATURE_NAUGHTYNESS.apply(this, true);
    FEATURE_OPEN_URL.apply(this, true);
    FEATURE_PARTIAL_SOUNDS.apply(this, true);
    FEATURE_MULTITHREADING.apply(this, true);
    FEATURE_POLYMOD_MODS.apply(this, true);
    FEATURE_CPPIA.apply(this, isCPP() && FEATURE_POLYMOD_MODS.isEnabled(this) && !isIOS());

    FEATURE_VIDEO_PLAYBACK.apply(this, true);
    FEATURE_VIDEO_SUBTITLES.apply(this, FEATURE_VIDEO_PLAYBACK.isEnabled(this) && !isWeb());

    FEATURE_DISCORD_RPC.apply(this, isDesktop() && !FEATURE_DEBUG_FUNCTIONS.isEnabled(this));
    FEATURE_MOBILE_RPC.apply(this, isMobile());
    FEATURE_LOST_FOCUS_VOLUME.apply(this, isDesktop());

    FEATURE_NEWGROUNDS.apply(this, true);
    FEATURE_NEWGROUNDS_DEBUG.apply(this, false);
    FEATURE_NEWGROUNDS_TESTING_MEDALS.apply(this, FEATURE_NEWGROUNDS.isEnabled(this) && FEATURE_DEBUG_FUNCTIONS.isEnabled(this));
    FEATURE_NEWGROUNDS_AUTOLOGIN.apply(this, FEATURE_NEWGROUNDS.isEnabled(this) && isWeb());
    FEATURE_NEWGROUNDS_EVENTS.apply(this, FEATURE_NEWGROUNDS.isEnabled(this));

    var editorsEnabled:Bool = isDesktop() || isMobile();
    FEATURE_DEBUG_MENU.apply(this, editorsEnabled);
    FEATURE_ANIMATION_EDITOR.apply(this, editorsEnabled);
    FEATURE_CHART_EDITOR.apply(this, editorsEnabled);
    FEATURE_STAGE_EDITOR.apply(this, editorsEnabled);
    FEATURE_CAMERA_EDITOR.apply(this, editorsEnabled);
    FEATURE_HAXEUI.apply(this, anyEditorEnabled());

    FEATURE_LAG_ADJUSTMENT.apply(this, !isWeb());
    FEATURE_SCREENSHOTS.apply(this, isDesktop());
    FEATURE_FILE_DROP.apply(this, !isMobile());
    FEATURE_ONE_CLICK_INSTALL.apply(this, isDesktop() || isMobile());
    FEATURE_TOUCH_HERE_TO_PLAY.apply(this, isWeb());

    FEATURE_HAPTICS.apply(this, isMobile());
    FEATURE_TOUCH_CONTROLS.apply(this, isMobile());

    var mobileRelease:Bool = isMobile() && isRelease();
    FEATURE_MOBILE_ADVERTISEMENTS.apply(this, mobileRelease && envConfig != null);
    FEATURE_MOBILE_IAP.apply(this, mobileRelease && envConfig != null);
    FEATURE_MOBILE_IAR.apply(this, mobileRelease);
    FEATURE_MOBILE_WEBVIEW.apply(this, isMobile() && FEATURE_NEWGROUNDS.isEnabled(this));
    FEATURE_MOBILE_AGESIGNALS.apply(this, mobileRelease);

    FEATURE_MOBILE_BATTERY_SAVER.apply(this, mobileRelease);
    FEATURE_MOBILE_SAFE_AREA.apply(this, isMobile());
    FEATURE_MOBILE_SUSPEND_ON_BACKGROUND.apply(this, isMobile() && !FEATURE_DEBUG_FUNCTIONS.isEnabled(this));
    FEATURE_MOBILE_PERFORMANCE_OVERLAY.apply(this, isMobile() && FEATURE_DEBUG_FUNCTIONS.isEnabled(this));
    FEATURE_MOBILE_ADAPTIVE_RESOLUTION.apply(this, mobileRelease);
    FEATURE_MOBILE_GESTURE_NAV_PADDING.apply(this, isAndroid());
    FEATURE_MOBILE_STORAGE_ACCESS_FRAMEWORK.apply(this, isAndroid() && FEATURE_POLYMOD_MODS.isEnabled(this));
    FEATURE_MOBILE_MODMENU_HAPTICS.apply(this, isMobile() && FEATURE_HAPTICS.isEnabled(this));

    FEATURE_HIGH_DPI.apply(this, !isMac());
    FEATURE_MACOS_GESTURES.apply(this, isMac());

    TESTING_ADS.apply(this, isDebug() && FEATURE_MOBILE_ADVERTISEMENTS.isEnabled(this));
    FEATURE_GHOST_TAPPING.apply(this, isMobile());
    FEATURE_COMPRESSED_TEXTURES.apply(this, mobileRelease && !isIOSSimulator());
    FEATURE_DEBUG_DISPLAY.apply(this, !isMobile() || FEATURE_DEBUG_FUNCTIONS.isEnabled(this));

    if (!isPassiveCommand()) renderFlagsTable();
  }

  function anyEditorEnabled():Bool
  {
    return FEATURE_ANIMATION_EDITOR.isEnabled(this)
      || FEATURE_CHART_EDITOR.isEnabled(this)
      || FEATURE_STAGE_EDITOR.isEnabled(this)
      || FEATURE_CAMERA_EDITOR.isEnabled(this);
  }

  function renderFlagsTable():Void
  {
    var check:String = "✓ ";
    var cross:String = "× ";
    var enabledFlags:Array<String> = [];
    var disabledFlags:Array<String> = [];
    var enabledWidth:Int = 0;
    var disabledWidth:Int = 0;

    for (flag in this.haxedefs.keys())
    {
      if (flag.startsWith(FeatureFlag.INVERSE_PREFIX))
      {
        var name:String = flag.substring(FeatureFlag.INVERSE_PREFIX.length);
        disabledWidth = Std.int(Math.max(name.length + cross.length, disabledWidth));
        disabledFlags.push(cross + name);
      }
      else
      {
        enabledWidth = Std.int(Math.max(flag.length + check.length, enabledWidth));
        enabledFlags.push(check + flag);
      }
    }

    enabledFlags.sort(Reflect.compare);
    disabledFlags.sort(Reflect.compare);

    var columnWidth:Int = enabledWidth + 5;
    var divider:String = "".rpad("-", columnWidth + disabledWidth + 2);

    info(divider);
    info("FEATURE FLAGS");
    info('Enabled Flags $check'.rpad(" ", columnWidth) + 'Disabled Flags $cross');
    info(divider);

    var rows:Int = Std.int(Math.max(enabledFlags.length, disabledFlags.length));
    for (i in 0...rows)
    {
      var left:String = i < enabledFlags.length ? enabledFlags[i] : "";
      var right:String = i < disabledFlags.length ? disabledFlags[i] : "";
      info(left.rpad(" ", columnWidth) + "| " + right);
    }

    info(divider);
  }

  function configureApp():Void
  {
    this.meta.title = isMobile() ? TITLE_MOBILE : TITLE;
    this.meta.version = VERSION;
    this.meta.packageName = PACKAGE_NAME;
    this.meta.company = COMPANY;
    this.meta.buildNumber = Std.string(BUILD_NUMBER);

    this.app.main = MAIN_CLASS;
    this.app.file = EXECUTABLE_NAME;
    this.app.preloader = PRELOADER;

    this.sources.push(SOURCE_DIR);
    this.templatePaths.push(TEMPLATES_DIR);

    this.preBuildCallbacks.push(buildHaxeCLICommand(PREBUILD_HX));
    this.postBuildCallbacks.push(buildHaxeCLICommand(POSTBUILD_HX));

    this.languages = LANGUAGES;

    this.window.fps = 60;
    this.window.width = 1280;
    this.window.height = 720;
    this.window.background = FEATURE_DEBUG_FUNCTIONS.isEnabled(this) ? 0xFFFF00FF : 0xFF000000;
    this.window.hardware = true;
    this.window.vsync = false;
    this.window.allowHighDPI = FEATURE_HIGH_DPI.isEnabled(this);

    if (isWeb())
    {
      this.window.resizable = true;
    }
    else if (isDesktop())
    {
      this.window.orientation = Orientation.LANDSCAPE;
      this.window.fullscreen = false;
      this.window.resizable = true;
    }
    else if (isMobile())
    {
      this.window.orientation = Orientation.LANDSCAPE;
      this.window.fullscreen = true;
      this.window.resizable = false;
      this.window.borderless = true;
      this.window.width = 0;
      this.window.height = 0;
    }

    if (isAndroid()) configureAndroidApp();
  }

  function configureAndroidApp():Void
  {
    if (EXCLUDE_ARMV7.isEnabled(this)) this.excludeArchitectures.push(Architecture.ARMV7);

    if (!isRelease()) return;

    var path:Null<String> = getEnv('KEYSTORE_PATH');
    var alias:Null<String> = getEnv('KEYSTORE_ALIAS');
    var password:Null<String> = getEnv('KEYSTORE_PASSWORD');

    if (path != null && alias != null && password != null)
    {
      var store = new Keystore();
      store.path = path;
      store.alias = alias;
      store.password = password;
      keystore = store;
    }

    if (isBundle()) config.set("android.gradle-project-directory", "bin-bundle");
  }

  function configureOutputDir():Void
  {
    var buildDir:String = 'export/${isDebug() ? 'debug' : 'release'}';
    if (FEATURE_DEBUG_TRACY.isEnabled(this)) buildDir += "-tracy";

    info('Output directory: $buildDir');

    buildDir += "/";
    app.path = buildDir;

    if (isWindows() && isCPP() && FEATURE_NATIVE_CRASH_HANDLER.isEnabled(this))
    {
      var pdbPath:String = Path.join([buildDir, 'windows', 'obj', 'Funkin.pdb']);
      setenv("HXCPP_PDB_FILE", FileSystem.absolutePath(pdbPath));
    }
  }

  function configureCompileDefines():Void
  {
    setHaxedef("funkin", VERSION);
    setHaxedef("openfl-enable-handle-error");
    setHaxedef("openfl_pool_events");
    setHaxedef("lime_disable_assets_version");
    setHaxedef("HXCPP_CHECK_POINTER");
    setHaxedef("HXCPP_STACK_LINE");
    setHaxedef("HXCPP_STACK_TRACE");
    setHaxedef("hscriptPos");
    setHaxedef("FLX_NO_FOCUS_LOST_SCREEN");
    setHaxedef("haxeui_no_mouse_reset");
    setHaxedef("haxeui_dont_impose_base_class");
    setHaxedef("message.reporting", "pretty");

    if (FEATURE_CPPIA.isEnabled(this))
    {
      setHaxedef("scriptable");
      setHaxedef("POLYMOD_CPPIA");
      excludeFromScripting();
    }

    if (FEATURE_DEBUG_FUNCTIONS.isDisabled(this))
    {
      setHaxedef("FLX_NO_DEBUG");
      setHaxedef("analyzer-optimize");
    }

    if (FEATURE_LOG_TRACE.isDisabled(this)) setHaxedef("no-traces");
    if (isRelease()) setHaxedef("NAPE_RELEASE_BUILD");
    if (FEATURE_MULTITHREADING.isEnabled(this)) setHaxedef("lime_threads");

    if (FEATURE_DEBUG_TRACY.isEnabled(this))
    {
      setHaxedef("HXCPP_TELEMETRY");
      setHaxedef("HXCPP_TRACY");
      setHaxedef("HXCPP_TRACY_MEMORY");
      setHaxedef("HXCPP_TRACY_ON_DEMAND");
      setHaxedef("absolute-paths");
    }
  }

  function excludeFromScripting():Void
  {
    for (pack in SCRIPTING_EXCLUDED_PACKAGES)
    {
      addHaxeMacro('haxe.macro.Compiler.addGlobalMetadata("$pack", "@:hscriptBaseCreated", true, true, false)');
    }
  }

  function configureIncludeMacros():Void
  {
    addHaxeFlag("-dce no");

    addHaxeMacro("include('funkin', true, ['funkin.mobile.*', 'funkin.ui.debug.anim.*', 'funkin.ui.debug.charting.*', 'funkin.ui.debug.stage.*', 'funkin.ui.debug.stageeditor.*', 'funkin.ui.debug.cameraeditor.*', 'funkin.ui.haxeui.*'])");

    if (isMobile()) addHaxeMacro("include('funkin.mobile')");

    if (FEATURE_HAXEUI.isEnabled(this))
    {
      if (FEATURE_ANIMATION_EDITOR.isEnabled(this)) addHaxeMacro("include('funkin.ui.debug.anim')");
      if (FEATURE_CHART_EDITOR.isEnabled(this)) addHaxeMacro("include('funkin.ui.debug.charting')");

      if (FEATURE_STAGE_EDITOR.isEnabled(this))
      {
        addHaxeMacro("include('funkin.ui.debug.stage')");
        addHaxeMacro("include('funkin.ui.debug.stageeditor')");
      }

      if (FEATURE_CAMERA_EDITOR.isEnabled(this)) addHaxeMacro("include('funkin.ui.debug.cameraeditor')");

      final haxeuiPackages:Array<String> = [
        'funkin.ui.haxeui',
        'haxe.ui.backend.flixel.components',
        'haxe.ui.core',
        'haxe.ui.components',
        'haxe.ui.containers',
        'haxe.ui.containers.dialogs',
        'haxe.ui.containers.menus',
        'haxe.ui.containers.properties'
      ];

      for (pack in haxeuiPackages) addHaxeMacro("include('" + pack + "')");
    }

    addHaxeMacro("include('animate')");
    addHaxeMacro("include('openfl')");
    addHaxeMacro("include('lime', true, ['lime.tools.*', 'lime._internal.*'])");
    addHaxeMacro("include('flixel', true, ['flixel.addons.editors.spine.*', 'flixel.addons.nape.*', 'flixel.system.macros.*', 'flixel.addons.tile.FlxRayCastTilemap'])");
  }

  function configureCustomMacros():Void
  {
    addHaxeMacro("addMetadata('@:build(funkin.util.macro.FlxMacro.buildFlxSprite())', 'flixel.FlxSprite')");
  }

  function configurePolymod():Void
  {
    setHaxedef("POLYMOD_SCRIPT_CLASS_EXT", ".hx,.hxc,.hscript");
    setHaxedef("POLYMOD_APPEND_FOLDER", "_append");
    setHaxedef("POLYMOD_MERGE_FOLDER", "_merge");
    setHaxedef("POLYMOD_ARCHIVE_MOD_EXT", ".zip,.fnfmod");
    setHaxedef("POLYMOD_MOD_METADATA_FILE", "_polymod_meta.json");
    setHaxedef("POLYMOD_MOD_ICON_FILE", "_polymod_icon.png,_polymod_icon.jpg,_polymod_icon.gif,_polymod_icon.webp");

    if (isDebug()) setHaxedef("POLYMOD_DEBUG");
  }

  function configureHaxelibs():Void
  {
    final always:Array<String> = [
      'flixel',
      'flixel-addons',
      'polymod',
      'flixel-animate',
      'json2object',
      'jsonpath',
      'jsonpatch',
      'thx.core',
      'thx.semver'
    ];

    for (lib in always) addHaxelib(lib);

    if (FEATURE_HAXEUI.isEnabled(this))
    {
      addHaxelib('haxeui-core');
      addHaxelib('haxeui-flixel');
    }

    if (isDebug() && isCPP()) addHaxelib('hxcpp-debug-server');
    if ((isDesktop() || isMobile()) && FEATURE_VIDEO_PLAYBACK.isEnabled(this)) addHaxelib('hxvlc');
    if (isAndroid()) addHaxelib('extension-androidtools');
    if (isLinux()) addHaxelib('hxgamemode');
    if (FEATURE_DISCORD_RPC.isEnabled(this)) addHaxelib('hxdiscord_rpc');
    if (FEATURE_MULTITHREADING.isEnabled(this)) addHaxelib('haxe-concurrent');
    if (FEATURE_NEWGROUNDS.isEnabled(this)) addHaxelib('newgrounds');

    if (FEATURE_FUNKVIS.isEnabled(this))
    {
      addHaxelib('funkin.vis');
      addHaxelib('grig.audio');
    }

    if (FEATURE_PARTIAL_SOUNDS.isEnabled(this)) addHaxelib('FlxPartialSound');
    if (FEATURE_HAPTICS.isEnabled(this)) addHaxelib('extension-haptics');
    if (FEATURE_MOBILE_ADVERTISEMENTS.isEnabled(this)) addHaxelib('extension-admob');
    if (FEATURE_MOBILE_IAP.isEnabled(this)) addHaxelib('extension-iapcore');
    if (FEATURE_MOBILE_IAR.isEnabled(this)) addHaxelib('extension-iarcore');
    if (FEATURE_MOBILE_WEBVIEW.isEnabled(this)) addHaxelib('extension-webviewcore');
    if (FEATURE_MOBILE_AGESIGNALS.isEnabled(this)) addHaxelib('extension-agesignals');
  }

  function configureASTCTextures():Void
  {
    if (isToolingCommand() || !FEATURE_COMPRESSED_TEXTURES.isEnabled(this)) return;

    readASTCExclusion();
    runASTCCompressor();
  }

  function configureAssets():Void
  {
    if (!isToolingCommand()) clearAssets();

    var exclude:Array<String> = EXCLUDE_ASSETS.concat(isWeb() ? EXCLUDE_ASSETS_WEB : EXCLUDE_ASSETS_NATIVE);
    exclude = exclude.concat(CENSOR_EXPLETIVES.isEnabled(this) ? EXCLUDE_ASSETS_CENSORED : EXCLUDE_ASSETS_UNCENSORED);

    var preloadDefault:Bool = !isWeb();
    var embedDefault:Bool = false;

    setHaxedef("disable_preload_default_library", preloadDefault ? "0" : "1");

    addAssetLibrary("default", embedDefault, preloadDefault);
    addAssetPath("assets", "assets", "default", ["*"], exclude, embedDefault);

    if (!HARDCODED_CREDITS.isEnabled(this))
    {
      addAsset("assets/exclude/ui/credits/credits.json", "assets/ui/credits/credits.json", "default", embedDefault);
    }

    final editorAssets:Array<{flag:FeatureFlag, path:String}> = [
      {flag: FEATURE_ANIMATION_EDITOR, path: 'assets/ui/editors/animation-editor'},
      {flag: FEATURE_CHART_EDITOR, path: 'assets/ui/editors/chart-editor'},
      {flag: FEATURE_STAGE_EDITOR, path: 'assets/ui/editors/stage-editor'},
      {flag: FEATURE_CAMERA_EDITOR, path: 'assets/ui/editors/camera-editor'}
    ];

    for (entry in editorAssets)
    {
      if (!entry.flag.isEnabled(this) && FileSystem.exists(entry.path)) removeAssetPath(entry.path, "default");
    }

    addAssetPath("assets/ui/fonts", null, "default", ["*"], exclude, true);

    addAssetLibrary("art", false, false);
    addAsset("art/readme.txt", "do NOT readme.txt", "art", false);
    addAsset("LICENSE.md", "LICENSE.md", "art", false);

    removeAssetPath("assets/exclude");

    info(embedDefault ? 'Done embedding assets.' : 'Done including assets.');
  }

  function clearAssets():Void
  {
    if (!isBuild()) return;

    var exportPath:String = app.path ?? "";
    var platform:String = isMac() ? 'macos' : Std.string(this.target);
    var basePath:String = Path.join([exportPath, platform, "bin"]);
    var assetsPath:Null<String> = null;

    if (isDesktop())
    {
      assetsPath = isMac() ? Path.join([basePath, '${this.app.file}.app', "Contents", "Resources", "assets"]) : Path.join([basePath, "assets"]);
    }
    else if (isAndroid() && !isBundle())
    {
      assetsPath = Path.join([basePath, "app", "src", "main", "assets", "assets"]);
    }
    else if (isIOS())
    {
      assetsPath = Path.join([exportPath, platform, '${this.app.file}', "assets", "assets"]);
    }

    if (assetsPath == null) return;

    if (FileSystem.exists(assetsPath))
    {
      info('Deleting assets folder from export folder ($assetsPath)');
      deleteDirectoryRecursive(assetsPath);
    }
    else
    {
      info('Assets folder does not exist ($assetsPath)');
    }
  }

  function deleteDirectoryRecursive(path:String):Void
  {
    if (!FileSystem.exists(path)) return;

    for (file in FileSystem.readDirectory(path))
    {
      var fullPath:String = Path.join([path, file]);
      if (FileSystem.isDirectory(fullPath)) deleteDirectoryRecursive(fullPath);
      else FileSystem.deleteFile(fullPath);
    }

    FileSystem.deleteDirectory(path);
  }

  function configureIcons():Void
  {
    info('Configuring application icons...');

    if (isAndroid())
    {
      adaptiveIcon = new AdaptiveIcon('art/icons/android/', true);
    }
    else if (isIOS())
    {
      final iosIcons:Array<{file:String, size:Int}> = [
        {file: "20x20@2x", size: 40},
        {file: "20x20@3x", size: 60},
        {file: "29x29", size: 29},
        {file: "29x29@2x", size: 58},
        {file: "29x29@3x", size: 87},
        {file: "40x40@2x", size: 80},
        {file: "60x60@2x", size: 120},
        {file: "60x60@3x", size: 180},
        {file: "1024x1024", size: 1024}
      ];

      for (icon in iosIcons) addIcon('art/icons/bf-iOS-Default-${icon.file}.png', icon.size);
      addIcon("art/icons/bf-iOS-Default-1024x1024.png");
    }
    else
    {
      for (size in [16, 32, 64]) addIcon('art/icons/icon$size.png', size);
      addIcon("art/icons/iconOG.png");
    }

    info('Done configuring icons.');
  }

  function configureAdMobKeys():Void
  {
    var appId:Null<String> = getEnv('ADMOB_APP_ID');

    if (appId == null)
    {
      error("ADMOB_APP_ID is not defined in the environment. Populate the .env file in your project root or build with -DNO_FEATURE_MOBILE_ADVERTISEMENTS");
      return;
    }

    setenv("ADMOB_APPID", appId);
  }

  function configureAndroid():Void
  {
    javaPaths.push(Path.join([SOURCE_DIR, 'funkin/external/android/java']));

    var provider:Xml = createElement('provider', [
      {name: 'android:authorities', value: '$PACKAGE_NAME.docprovider'},
      {name: 'android:name', value: 'funkin.provider.DataFolderProvider'},
      {name: 'android:grantUriPermissions', value: 'true'},
      {name: 'android:exported', value: 'true'},
      {name: 'android:permission', value: 'android.permission.MANAGE_DOCUMENTS'}
    ]);
    provider.addChild(createIntentFilter('android.content.action.DOCUMENTS_PROVIDER', [], []));
    appendAndroidXml('android.application', provider);

    final browsable:Array<String> = ["android.intent.category.DEFAULT", "android.intent.category.BROWSABLE"];

    var fnfcData:Array<XmlAttribute> = [
      {name: "android:mimeType", value: "application/zip"},
      {name: "android:scheme", value: "file"},
      {name: "android:scheme", value: "content"}
    ];

    for (depth in 0...5)
    {
      fnfcData.push({name: "android:pathPattern", value: [for (_ in 0...depth) ".*\\."].join("") + ".*\\.fnfc"});
    }

    appendAndroidXml('android.activity', createIntentFilter('android.intent.action.VIEW', browsable, fnfcData));
    appendAndroidXml('android.activity', createIntentFilter('android.intent.action.VIEW', browsable, [{name: "android:scheme", value: "funkin"}]));

    var existing:Array<String> = config.getArrayString('android.extension') ?? [];
    for (extension in ANDROID_EXTENSIONS)
    {
      if (!existing.contains(extension)) config.push("android.extension", extension);
    }
  }

  static function createElement(name:String, attributes:Array<XmlAttribute>):Xml
  {
    var element:Xml = Xml.createElement(name);
    for (attribute in attributes) element.set(attribute.name, attribute.value);
    return element;
  }

  static function createIntentFilter(actionName:String, categories:Array<String>, data:Array<XmlAttribute>):Xml
  {
    var filter:Xml = Xml.createElement('intent-filter');
    filter.addChild(createElement('action', [{name: 'android:name', value: actionName}]));

    for (category in categories) filter.addChild(createElement('category', [{name: 'android:name', value: category}]));
    for (entry in data) filter.addChild(createElement('data', [entry]));

    return filter;
  }

  function appendAndroidXml(section:String, node:Xml):Void
  {
    var printed:String = Printer.print(node, true);

    @:nullSafety(Off)
    {
      var entry:Dynamic = config.get(section);
      if (entry.xmlChildren != null) entry.xmlChildren.push(printed);
      else entry.xmlChildren = [printed];
    }
  }

  function configureIOS():Void
  {
    config.set("ios.deployment", IOS_DEPLOYMENT_TARGET);
    config.set("ios.non-exempt-encryption", "false");
    config.set("ios.team-id", getEnvAny(['IOS_TEAM_ID', 'TEAM_ID']) ?? IOS_TEAM_ID);

    var identity:Null<String> = getEnvAny(['IOS_CODE_SIGN_IDENTITY', 'CODE_SIGN_IDENTITY']);
    if (identity != null) config.set("ios.identity", identity);

    var profile:Null<String> = getEnvAny(['IOS_PROVISIONING_PROFILE', 'PROVISIONING_PROFILE']);
    if (profile != null) config.set("ios.provisioning-profile", profile);
  }

  function configureCppiaSdk():Void
  {
    if (isToolingCommand()) return;

    var target:Null<String> = isWindows() ? "windows" : isMac() ? "mac" : isLinux() ? "linux" : null;
    if (target == null) return;

    var buildConfig:String = isDebug() ? "debug" : "release";
    var outputDir:String = 'sdk/$target/$buildConfig';
    var script:String = 'scripts/cppia/sdk/build_cppia_sdk';

    if (isWindowsHost())
    {
      postBuildCallbacks.push(new CLICommand("powershell", [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        '$script.ps1',
        "-Target",
        target,
        "-Config",
        buildConfig,
        ".",
        outputDir
      ]));
    }
    else
    {
      postBuildCallbacks.push(new CLICommand("bash", ['$script.sh', "--target", target, "--config", buildConfig, ".", outputDir]));
    }
  }

  public function isWeb():Bool
  {
    return this.platformType == PlatformType.WEB;
  }

  public function isMobile():Bool
  {
    return this.platformType == PlatformType.MOBILE;
  }

  public function isDesktop():Bool
  {
    return this.platformType == PlatformType.DESKTOP;
  }

  public function isConsole():Bool
  {
    return this.platformType == PlatformType.CONSOLE;
  }

  public function is32Bit():Bool
  {
    return this.architectures.contains(Architecture.X86);
  }

  public function is64Bit():Bool
  {
    return this.architectures.contains(Architecture.X64);
  }

  public function isWindowsHost():Bool
  {
    return System.hostPlatform == WINDOWS;
  }

  public function isMacHost():Bool
  {
    return System.hostPlatform == MAC;
  }

  public function isLinuxHost():Bool
  {
    return System.hostPlatform == LINUX;
  }

  public function isWindows():Bool
  {
    return this.target == Platform.WINDOWS;
  }

  public function isMac():Bool
  {
    return this.target == Platform.MAC;
  }

  public function isLinux():Bool
  {
    return this.target == Platform.LINUX;
  }

  public function isAndroid():Bool
  {
    return this.target == Platform.ANDROID;
  }

  public function isIOS():Bool
  {
    return this.target == Platform.IOS;
  }

  public function isIOSSimulator():Bool
  {
    return isIOS() && this.targetFlags.exists("simulator");
  }

  public function isCPP():Bool
  {
    return this.defines.exists("cpp");
  }

  public function isDisplay():Bool
  {
    return this.command == "display";
  }

  public function isCleanCommand():Bool
  {
    return this.command == "clean";
  }

  public function isCleanFlag():Bool
  {
    return this.targetFlags.exists("clean");
  }

  public function isRun():Bool
  {
    return this.command == "run";
  }

  public function isInstall():Bool
  {
    return this.command == "install";
  }

  public function isUninstall():Bool
  {
    return this.command == "uninstall";
  }

  public function isBuild():Bool
  {
    return this.command == "test" || this.command == "build";
  }

  public function isPassiveCommand():Bool
  {
    return isRun() || isInstall() || isUninstall();
  }

  public function isToolingCommand():Bool
  {
    return isDisplay() || isCleanCommand();
  }

  public function isQuiet():Bool
  {
    return isToolingCommand() || isPassiveCommand();
  }

  public function isDebug():Bool
  {
    return this.debug;
  }

  public function isRelease():Bool
  {
    return !isDebug();
  }

  public function isBundle():Bool
  {
    return isAndroid() && this.targetFlags.exists("bundle");
  }

  public function getHaxedef(name:String):Null<Dynamic>
  {
    return this.haxedefs.get(name);
  }

  public function setHaxedef(name:String, ?value:String):Void
  {
    this.haxedefs.set(name, value ?? "");
  }

  public function unsetHaxedef(name:String):Void
  {
    this.haxedefs.remove(name);
  }

  public function getDefine(name:String):Null<Dynamic>
  {
    return this.defines.get(name);
  }

  public function hasDefine(name:String):Bool
  {
    return this.defines.exists(name);
  }

  public function addHaxelib(name:String, version:String = ""):Void
  {
    this.haxelibs.push(new Haxelib(name, version));
  }

  public function addHaxeFlag(value:String):Void
  {
    this.haxeflags.push(value);
  }

  public function addHaxeMacro(value:String):Void
  {
    addHaxeFlag('--macro $value');
  }

  public function addIcon(icon:String, ?size:Int):Void
  {
    this.icons.push(new Icon(icon, size));
  }

  public function addAsset(path:String, ?rename:String, ?library:String, embed:Bool = false, ?padName:String):Void
  {
    if (FEATURE_COMPRESSED_TEXTURES.isEnabled(this) && Path.extension(path) == 'png' && !isASTCExcluded(path))
    {
      var astcPath:String = "astc-textures/" + Path.withoutExtension(path) + ".astc";
      if (FileSystem.exists(astcPath))
      {
        path = astcPath;
        if (rename != null) rename = Path.withoutExtension(rename) + ".astc";
      }
    }

    var asset = new Asset(path, rename, null, embed, true);

    @:nullSafety(Off)
    asset.library = library ?? "default";

    if (padName != null && isBundle()) asset.deliveryPackName = padName;

    this.assets.push(asset);
  }

  public function removeAsset(path:String, ?library:String):Void
  {
    for (asset in this.assets)
    {
      if (asset.sourcePath != path) continue;
      if (library != null && asset.library != library) continue;
      this.assets.remove(asset);
      return;
    }
  }

  public function addAssetPath(path:String, ?rename:String, library:String, ?include:Array<String>, ?exclude:Array<String>, embed:Bool = false,
      ?padName:String):Void
  {
    if (path == "") return;

    var includes:Array<String> = include ?? [];
    var excludes:Array<String> = exclude ?? [];

    validateDirectory(path);

    var targetPath:String = rename ?? path;
    if (targetPath != "") targetPath += "/";

    for (file in FileSystem.readDirectory(path))
    {
      var sourcePath:String = '$path/$file';

      if (FileSystem.isDirectory(sourcePath))
      {
        if (this.filter(file, ["*"], excludes)) addAssetPath(sourcePath, '$targetPath$file', library, includes, excludes, embed, padName);
      }
      else if (this.filter(file, includes, excludes))
      {
        addAsset(sourcePath, '$targetPath$file', library, embed, padName);
      }
    }
  }

  public function removeAssetPath(path:String, ?library:String):Void
  {
    if (path == "") return;

    validateDirectory(path);

    for (exclude in EXCLUDE_ASSETS)
    {
      if (path.contains(exclude.replace('*', ''))) return;
    }

    for (file in FileSystem.readDirectory(path))
    {
      var sourcePath:String = '$path/$file';
      if (FileSystem.isDirectory(sourcePath)) removeAssetPath(sourcePath, library);
      else removeAsset(sourcePath, library);
    }
  }

  function validateDirectory(path:String):Void
  {
    if (!FileSystem.exists(path)) error('Could not find asset path "$path".');
    else if (!FileSystem.isDirectory(path)) error('Could not parse asset path "$path", expected a directory.');
  }

  public function addAssetLibrary(name:String, embed:Bool = false, preload:Bool = false):Void
  {
    this.libraries.push(new Library('', name, null, embed, preload, false, ""));
  }

  public function buildCLICommand(cmd:String):CLICommand
  {
    return CommandHelper.fromSingleString(cmd);
  }

  public function buildHaxeCLICommand(path:String):CLICommand
  {
    return CommandHelper.interpretHaxe(path);
  }

  static function runProcess(command:String, args:Array<String>):ProcessResult
  {
    try
    {
      var process = new Process(command, args);
      var output:String = process.stdout.readAll().toString().trim();
      var code:Int = process.exitCode(true);
      process.close();
      return {code: code, output: output};
    }
    catch (e:Dynamic)
    {
      return {code: -1, output: ""};
    }
  }

  public function getGitCommit():String
  {
    var result = runProcess('git', ['rev-parse', 'HEAD']);
    if (result.code != 0) error('Could not determine current git commit; is this a proper Git repository?');
    return result.output.substr(0, 7);
  }

  public function getGitBranch():String
  {
    var result = runProcess('git', ['rev-parse', '--abbrev-ref', 'HEAD']);
    if (result.code != 0) error('Could not determine current git branch; is this a proper Git repository?');
    return result.output;
  }

  public function getGitModified():Bool
  {
    return runProcess('git', ['diff', '--quiet']).code == 1;
  }

  @SuppressWarnings('checkstyle:Dynamic')
  function checkLibraries():Void
  {
    if (!FileSystem.exists(HMM_FILE)) return;

    var hmmData:Dynamic = haxe.Json.parse(File.getContent(HMM_FILE));
    var dependencies:Array<Dynamic> = cast hmmData.dependencies;
    var mismatches:Array<LibraryMismatch> = [];

    for (library in dependencies)
    {
      var name:String = Std.string(library.name).replace(".", ",");
      var devPath:String = readLibraryDev(name);
      var isDev:Bool = devPath != "" && !isLibraryLocalGitDev(name);

      switch (Std.string(library.type))
      {
        case 'haxelib':
          var expected:String = Std.string(library.version);
          var current:String = isDev ? readLibraryGitCommitHash(name) : readLibraryCurrentVersion(name);
          if (isDev || current != expected) mismatches.push({name: name, devPath: isDev ? devPath : "", current: current, expected: expected});
        case 'git':
          var expected:String = Std.string(library.ref);
          var current:String = readLibraryGitCommitHash(name);
          if (current != expected) mismatches.push({name: name, devPath: isDev ? devPath : "", current: current, expected: expected});
        default:
      }
    }

    if (mismatches.length == 0) return;

    warn("Some libraries differ from the versions defined in hmm.json.".bold().yellow());
    warn("To ensure consistency, it's recommended to stop the build and run `hmm reinstall [library]`.".bold().yellow());
    warn("If you're intentionally using development builds or newer versions, you can ignore this warning.".bold().yellow());

    Sys.println('');

    for (lib in mismatches)
    {
      var displayName:String = lib.name.replace(",", ".");

      if (Path.isAbsolute(lib.devPath))
      {
        Sys.println("- " + displayName + " (Development Build)".bright_cyan());
        Sys.println(("   Path:     " + Path.removeTrailingSlashes(lib.devPath)).bright_blue());
      }
      else
      {
        Sys.println("- " + displayName);
      }

      Sys.println(("   Current:  " + lib.current).red());
      Sys.println(("   Expected: " + lib.expected).green());
    }

    Sys.println('');
  }

  static function readTrimmedFile(path:String):String
  {
    return FileSystem.exists(path) ? File.getContent(path).trim() : '';
  }

  static function readLibraryCurrentVersion(libraryName:String):String
  {
    return readTrimmedFile(getLibraryFile(libraryName, '.current'));
  }

  static function readLibraryDev(libraryName:String):String
  {
    return readTrimmedFile(getLibraryFile(libraryName, '.dev'));
  }

  static function readLibraryGitCommitHash(libraryName:String):String
  {
    var gitPath:String = getLibraryFile(libraryName, 'git');
    if (FileSystem.exists(gitPath))
    {
      var result = runProcess("git", ["-C", gitPath, "rev-parse", "HEAD"]);
      if (result.code == 0 && result.output.length > 0) return result.output;
    }

    var devPath:String = readLibraryDev(libraryName);
    if (devPath.length > 0 && FileSystem.exists(devPath))
    {
      var result = runProcess("git", ["-C", devPath, "rev-parse", "HEAD"]);
      if (result.code == 0) return result.output;
    }

    return '';
  }

  static function getLibraryFile(libraryName:String, file:String):String
  {
    return Path.join([Path.addTrailingSlash(Sys.getCwd()), '.haxelib', libraryName, file]);
  }

  static function isLibraryLocalGitDev(libraryName:String):Bool
  {
    var gitPath:String = getLibraryFile(libraryName, 'git');
    var devFile:String = getLibraryFile(libraryName, '.dev');

    if (!FileSystem.exists(gitPath) || !FileSystem.exists(devFile)) return false;

    return Path.normalize(readLibraryDev(libraryName)).startsWith(gitPath);
  }

  static function getLibraryPath(libraryName:String):String
  {
    var output:String = runProcess('haxelib', ['libpath', libraryName]).output;
    return output.split('\n')[0].trim();
  }

  public function buildHxCppTools():Void
  {
    var path:String = getLibraryPath("hxcpp");

    if (path.length == 0 || path.toLowerCase().startsWith("error") || !FileSystem.exists(path))
    {
      error('HXCPP could not be found while on C++ target.');
      return;
    }

    if (FileSystem.exists(Path.join([path, 'hxcpp.n']))) return;

    info('Compiling the HXCPP Build Tool...');

    var oldDir:String = Sys.getCwd();
    Sys.setCwd(Path.join([path, 'tools/hxcpp']));

    var result = runProcess('haxe', ['compile.hxml']);

    Sys.setCwd(oldDir);

    if (result.code != 0) info('Could not compile the Build Tool. Is HXCPP installed correctly? Continuing...');
    else info('Compiled the HXCPP Build Tool successfully!');
  }

  public function error(message:String):Void
  {
    Sys.stderr().write(Bytes.ofString(' ERROR '.bold().bg_red() + " " + message + "\n"));
    Sys.exit(1);
  }

  public function info(message:String):Void
  {
    if (!isQuiet()) Sys.println(' INFO '.bold().bg_blue() + " " + message);
  }

  public function warn(message:String):Void
  {
    if (!isQuiet()) Sys.println(' WARNING '.bold().bg_yellow() + " " + message);
  }

  function getEnv(key:String):Null<String>
  {
    var env:Null<Map<String, String>> = envConfig;
    if (env == null) return null;

    var value:Null<String> = env.get(key);
    return value == null || value.length == 0 ? null : value;
  }

  function getEnvAny(keys:Array<String>):Null<String>
  {
    for (key in keys)
    {
      var value:Null<String> = getEnv(key);
      if (value != null) return value;
    }
    return null;
  }

  public function readEnvironmentFile(file:String):Null<Map<String, String>>
  {
    if (!FileSystem.exists(file))
    {
      warn('Environment file does not exist: $file');
      return null;
    }

    var env = new Map<String, String>();

    for (rawLine in File.getContent(file).split('\n'))
    {
      var line:String = rawLine.trim();

      if (line.length == 0 || line.startsWith('#') || shouldExcludeEnvKey(line)) continue;

      var index:Int = line.indexOf('=');
      if (index <= 0) continue;

      var value:String = unquote(line.substr(index + 1).trim());
      if (value.length == 0) continue;

      env.set(stripEnvTargetPrefix(line.substr(0, index).trim()), value);
    }

    return env;
  }

  static function unquote(value:String):String
  {
    if (value.length < 2) return value;

    var first:String = value.charAt(0);
    var last:String = value.charAt(value.length - 1);

    if ((first == '"' || first == "'") && first == last) return value.substr(1, value.length - 2);

    return value;
  }

  public function shouldExcludeEnvKey(key:String):Bool
  {
    var android:Bool = key.startsWith('ANDROID_');
    var ios:Bool = key.startsWith('IOS_');
    var mobile:Bool = key.startsWith('MOBILE_') || ios || android;
    var web:Bool = key.startsWith('WEB_');
    var desktop:Bool = key.startsWith('DESKTOP_');
    var native:Bool = key.startsWith('NATIVE_');

    if (isWeb()) return mobile || desktop || native;
    if (isDesktop()) return mobile || web;
    if (isAndroid()) return ios || web || desktop;
    if (isIOS()) return android || web || desktop;

    return false;
  }

  public function stripEnvTargetPrefix(key:String):String
  {
    var index:Int = key.indexOf('_');
    if (index == -1) return key;

    var prefix:String = key.substr(0, index);
    var rest:String = key.substr(index + 1);

    var allowed:Array<String> = if (isAndroid()) ['ANDROID', 'MOBILE', 'NATIVE'] else if (isIOS()) ['IOS', 'MOBILE', 'NATIVE'] else if (isWeb()) ['WEB'] else
      if (isDesktop()) ['DESKTOP', 'NATIVE'] else [];

    return allowed.contains(prefix) ? rest : key;
  }

  public function readASTCExclusion():Void
  {
    if (!FileSystem.exists(ASTC_DATA_FILE))
    {
      astcExcludes = [];
      return;
    }

    @:nullSafety(Off)
    {
      var data:Dynamic = haxe.Json.parse(File.getContent(ASTC_DATA_FILE));
      var excludes:Array<String> = data.excludes;
      astcExcludes = excludes == null ? [] : [for (entry in excludes) entry.trim()];
    }
  }

  public function isASTCExcluded(file:String):Bool
  {
    var normalizedFile:String = Path.normalize(file);

    for (exclusion in astcExcludes)
    {
      if (exclusion.endsWith("/*"))
      {
        if (Path.directory(normalizedFile) == Path.normalize(exclusion.substr(0, exclusion.length - 2))) return true;
      }
      else if (exclusion.endsWith("/"))
      {
        if (normalizedFile.startsWith(Path.normalize(exclusion))) return true;
      }
      else if (file == exclusion)
      {
        return true;
      }
    }

    return false;
  }

  public function runASTCCompressor():Void
  {
    info('Compressing ASTC textures...');

    var args:Array<String> = ['run', 'astc-compressor', 'compress-from-json', '-json', ASTC_DATA_FILE];
    if (isCleanFlag()) args.push('-clean');

    Sys.command('haxelib', args);

    info('Done compressing ASTC textures.');
  }
}

abstract FeatureFlag(String) from String to String
{
  public static final INVERSE_PREFIX:String = "NO_";

  public function new(input:String)
  {
    this = input;
  }

  @:from
  public static function fromString(input:String):FeatureFlag
  {
    return new FeatureFlag(input);
  }

  public function apply(project:Project, enableByDefault:Bool = false):Void
  {
    if (isEnabled(project)) getInverse().disable(project, false);
    else if (getInverse().isEnabled(project)) disable(project, false);
    else if (enableByDefault) enable(project, true);
    else disable(project, true);
  }

  public function enable(project:Project, andInverse:Bool = true):Void
  {
    project.setHaxedef(this, "");
    if (andInverse) getInverse().disable(project, false);
  }

  public function disable(project:Project, andInverse:Bool = true):Void
  {
    project.unsetHaxedef(this);
    if (andInverse) getInverse().enable(project, false);
  }

  public function isEnabled(project:Project):Bool
  {
    return project.haxedefs.exists(this) || project.defines.exists(this);
  }

  public function isDisabled(project:Project):Bool
  {
    return getInverse().isEnabled(project);
  }

  public function getInverse():FeatureFlag
  {
    return this.startsWith(INVERSE_PREFIX) ? this.substring(INVERSE_PREFIX.length) : INVERSE_PREFIX + this;
  }
}
